# Copie este arquivo para application-local.properties e preencha valores reais.
# application-local.properties está no .gitignore e não deve ir para o GitHub.

SPRING_DATASOURCE_USERNAME=your-db-user
SPRING_DATASOURCE_PASSWORD=change-me
DB_USER=your-db-user
DB_PASSWORD=change-me
DB_NAME=bacteria_db

# Use pelo menos 32 caracteres aleatórios
JWT_SECRET=change-me-use-a-long-random-string-min-32-chars

AWS_S3_ACCESS_KEY=change-me
AWS_S3_SECRET_KEY=change-me
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=genomes

BACRESIST_INTERNAL_KEY=change-me
