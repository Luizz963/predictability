# Copie este arquivo para .env e preencha valores reais.
# O arquivo .env está no .gitignore e não deve ir para o GitHub.

# MinIO
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_ENDPOINT=http://minio-storage:9000
S3_BUCKET=genomes

# MySQL
DB_ROOT_PASSWORD=change-me
DB_NAME=bacteria_db
DB_USER=change-me
DB_PASSWORD=change-me

# APIs — JWT_SECRET com pelo menos 32 caracteres aleatórios
BACRESIST_INTERNAL_KEY=change-me
JWT_SECRET=change-me-use-a-long-random-string-min-32-chars

# Caminho local do motor de inferência Python (não commitar caminho da sua máquina no compose)
PYTHON_AI_BUILD_CONTEXT=../bacresist-inference
